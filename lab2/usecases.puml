@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач" as User
actor "Гість" as Guest
actor "Зареєстрований клієнт" as Customer
actor "Адміністратор" as Admin

Guest -up-|> User
Customer -up-|> User

rectangle "Онлайн-магазин" {
    usecase "UC-1: Перегляд каталогу" as UC1
    usecase "UC-2: Оформлення замовлення" as UC2
    usecase "UC-3: Оплата замовлення" as UC3
    usecase "UC-4: Керування каталогом та акціями" as UC4
    usecase "UC-5: Вибір способу оплати" as UC5
}

User --> UC1
Customer --> UC2
Customer --> UC3
Admin --> UC4

UC2 .> UC3 : <<include>>
UC5 .> UC3 : <<extend>>
@enduml
