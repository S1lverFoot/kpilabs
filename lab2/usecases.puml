@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач" as User
actor "Гість" as Guest
actor "Зареєстрований клієнт" as Customer
actor "Банківська система" as Bank

Guest -up-|> User
Customer -up-|> User

rectangle "Онлайн-магазин" {
    usecase "Перегляд каталогу" as UC1
    usecase "Оформлення замовлення" as UC2
    usecase "Оплата замовлення" as UC3
    usecase "Авторизація" as UC4
}

User --> UC1
Customer --> UC2
Customer --> UC4

UC3 .> UC2 : <<include>>
UC2 .> UC4 : <<include>>

Bank --> UC3
@enduml
