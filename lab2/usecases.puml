@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач" as User
actor "Гість" as Guest
actor "Зареєстрований клієнт" as Customer
actor "Банківська система" as Bank

' Узагальнення (успадкування) акторів
Guest -up-|> User
Customer -up-|> User

rectangle "Онлайн-магазин" {
    usecase "Перегляд каталогу" as UC1
    usecase "Оформлення замовлення" as UC2
    usecase "Оплата замовлення" as UC3
    usecase "Авторизація" as UC4
}

User --> UC1
Customer --> UC2
Customer --> UC4

' Оплата включає (include) Оформлення замовлення
UC3 .> UC2 : <<include>>
' Оформлення замовлення вимагає авторизації
UC2 .> UC4 : <<include>>

' Зовнішній актор викликає процес оплати
Bank --> UC3
@enduml
