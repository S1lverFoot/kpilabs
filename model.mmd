erDiagram
    Customer {
        string id PK "UUID"
        string name
        string email
    }
    Category {
        string id PK "UUID"
        string name
    }
    Product {
        string id PK "UUID"
        string category_id FK "UUID"
        string name
        float price
        int stock_quantity
    }
    Order {
        string id PK "UUID"
        string customer_id FK "UUID"
        string status
        datetime created_at
    }
    Order_Item {
        string id PK "UUID"
        string order_id FK "UUID"
        string product_id FK "UUID"
        int quantity
        float unit_price
    }

    Category ||--o{ Product : contains
    Customer ||--o{ Order : places
    Order ||--|{ Order_Item : includes
    Product ||--o{ Order_Item : ordered_in
