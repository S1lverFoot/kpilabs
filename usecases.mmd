usecaseDiagram
    actor Customer as Клієнт
    actor Gateway as Платіжний шлюз
    
    rectangle "Онлайн-магазин" {
        usecase "Перегляд каталогу" as UC1
        usecase "Оформлення замовлення" as UC2
        usecase "Оплата замовлення" as UC3
        usecase "Авторизація" as UC4
        usecase "Застосування знижки" as UC5
        usecase "Сповіщення про помилку" as UC6
    }

    Customer --> UC1
    Customer --> UC2
    Customer --> UC4
    
    UC2 .> UC4 : <<include>>
    UC3 .> UC2 : <<include>>
    
    Gateway --> UC3
    
    UC5 ..> UC1 : <<extend>>
    UC6 ..> UC3 : <<extend>>
